local Stream_To_Binary=require'Stream_To_Binary'

local Binary_Open='b'
--	necessary. to not include any '\r' (in text mode, will auto add '\r' before write '\n', and `read'l'` will broken with separate '\r' and '\n').

local function Display_Stream_Binary_Data(File_Path)
	local File_Handle=assert(io.open(File_Path,'r'..Binary_Open))
	local Stream_Binary_Accessor=Stream_To_Binary(File_Handle)
	print(Stream_Binary_Accessor:Read_Name())
	local Iter_Data=Stream_Binary_Accessor:Iter_Data()
	repeat
		local Values={Iter_Data()}
		print(table.unpack(Values))
	until #Values==0
end

local Default_File='Stream_Binary_Data.luab'

do
	local File_Handle_For_Write=io.open(Default_File,'w'..Binary_Open)
	File_Handle_For_Write:setvbuf('full',0xffff)
	Stream_To_Binary(File_Handle_For_Write)
	:Write_Data_Type(1,-2,1.0)
	:Write_Name('A','B','C')
	:Append_Data(255,-0x7fff,1.2)
	:Append_Data(0,0x7fff,0.12)
	:Close()
	local File_Handle=io.open(Default_File,'r+'..Binary_Open)
	local Access_Binary=Stream_To_Binary(File_Handle)
	local Name_List={Access_Binary:Read_Name()}
	assert(Name_List[1]=='A' and Name_List[2]=='B' and Name_List[3]=='C')
	local Value_List={}
	local File_Position_List={}
	for a,b,c,File_Position in Access_Binary:Iter_Data(--[[default 'Towards End']]) do
		table.insert(Value_List,a)
		table.insert(Value_List,b)
		table.insert(Value_List,c)
		table.insert(File_Position_List,File_Position)
	end
	assert(Value_List[1]==255
		and Value_List[2]==-0x7fff
		and math.abs(Value_List[3]-1.2)<0.001
		and Value_List[4]==0
		and Value_List[5]==0x7fff
		and math.abs(Value_List[6]-0.12)<0.00001
	)
	assert(File_Position_List[1]==10 and File_Position_List[2]==20)
	Display_Stream_Binary_Data(Default_File)
	----
	local Previous_File_Position=File_Position_List[2]
	----
	local Value_List={}
	local File_Position_List={}
	for a,b,c,File_Position in Access_Binary:Iter_Data(nil,'Towards Begin') do
		table.insert(Value_List,a)
		table.insert(Value_List,b)
		table.insert(Value_List,c)
		table.insert(File_Position_List,File_Position)
	end
	assert(Value_List[4]==255
		and Value_List[5]==-0x7fff
		and math.abs(Value_List[6]-1.2)<0.001
		and Value_List[1]==0
		and Value_List[2]==0x7fff
		and math.abs(Value_List[3]-0.12)<0.00001
	)
	----
	Access_Binary:Append_Data(1,2,3)--appen new
	----
	local Value_List={}
	local File_Position_List={}
	for a,b,c,File_Position in Access_Binary:Iter_Data(Previous_File_Position,'Towards Begin') do
		table.insert(Value_List,a)
		table.insert(Value_List,b)
		table.insert(Value_List,c)
		table.insert(File_Position_List,File_Position)
	end
	assert(Value_List[4]==255
		and Value_List[5]==-0x7fff
		and math.abs(Value_List[6]-1.2)<0.001
		and Value_List[1]==0
		and Value_List[2]==0x7fff
		and math.abs(Value_List[3]-0.12)<0.00001
	)
	assert(File_Position_List[2]==10 and File_Position_List[1]==20)
end

do
	local File_Handle_For_Write=io.open(Default_File,'w'..Binary_Open)
	local Stream_Binary_Accessor=Stream_To_Binary(File_Handle_For_Write)
	print(Stream_Binary_Accessor:Read_Name())
	Stream_Binary_Accessor:Write_Data_Type(0xffffffff,0xffff,'f'):Write_Name('Date_Time','Millisecond','Random')
	local Data_Time,Millisecond
	for Index=1,7 do
		Data_Time,Millisecond=os.time(),os.clock()%1*1000//1
		Stream_Binary_Accessor:Append_Data(Data_Time,Millisecond,math.random())
	end
	File_Handle_For_Write:close()
	--------
	Display_Stream_Binary_Data(Default_File)
end
print'test OK'